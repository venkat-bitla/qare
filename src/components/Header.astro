---
// MobileMenu.astro
---

<header class="fixed top-5 w-full z-10 flex justify-center px-4">
  <nav class="w-full max-w-5xl bg-neutral-200/60 backdrop-blur-lg shadow-sm px-4 sm:px-6 py-2 rounded-md">
    <div class="flex justify-between items-center">
      <!-- Logo -->
      <a href="/" class="flex items-center">
        <svg xmlns="http://www.w3.org/2000/svg" transform="rotate(270 0 0)" class="w-6 h-6 text-brand mt-2 mx-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719"/>
          <path d="M8 12h8"/>
          <path d="M12 8v8"/>
        </svg>        
        <span class="hidden lg:inline-block text-3xl font-semibold whitespace-nowrap text-gray-800 dark:text-white">
          qare
        </span>
      </a>

      <!-- Desktop Nabricolagetion -->
      <div class="hidden lg:flex items-center space-x-5">
        <a href="#features" class="font-bricolage tracking-wider  text-gray-600 hover:text-gray-900 transition-colors">Features</a>
        <a href="/blog" class="font-bricolage tracking-wider  text-gray-600 hover:text-gray-900 transition-colors">Blog</a>
        <span class="h3 mx-3 text-gray-500">✦</span> 
        <a
          href="https://app.qare.in/sign_in"
          target="_blank"
          class="font-bricolage tracking-wider inline-flex items-center hover:text-brand dark:text-white hover:bg-gray-100 focus:ring-2 focus:ring-gray-300 font-medium rounded-md text-sm px-4 py-2 dark:hover:bg-gray-700 dark:focus:ring-gray-800"
        >
          Login
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="ml-1 w-4 h-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M7 7h10v10"></path>
            <path d="M7 17 17 7"></path>
          </svg>
        </a>
        <a
          href="https://app.qare.in/sign_up"
          target="_blank"
          class="font-bricolage tracking-wider  inline-flex items-center text-white bg-brand hover:bg-brand-dark focus:ring-2 focus:ring-brand-dark font-medium shadow-sm text-sm px-4 py-2 dark:bg-slate-600 dark:hover:bg-slate-700 dark:focus:ring-slate-800 rounded-md"
        >
          Get a Demo
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="lg:hidden inline-flex items-center p-2 text-sm text-slate-500 rounded-lg hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-slate-200 dark:text-slate-400 dark:hover:bg-slate-700 dark:focus:ring-slate-600"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <span class="sr-only">Open main menu</span>
        <!-- Hamburger Icon -->
        <svg
          id="hamburger-icon"
          class="w-6 h-6 transition-transform duration-200"
          fill="currentColor"
          viewBox="0 0 20 20"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            fill-rule="evenodd"
            d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"
            clip-rule="evenodd"
          ></path>
        </svg>
        <!-- Close Icon (hidden by default) -->
        <svg
          id="close-icon"
          class="w-6 h-6 transition-transform duration-200 hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="lg:hidden overflow-hidden transition-all duration-300 ease-in-out max-h-0">
      <div class="pt-3 pb-2 space-y-1">
        <a
          href="#features"
          class="font-bricolage tracking-wider block px-4 py-2 text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-100 dark:text-gray-300 dark:hover:text-white dark:hover:bg-slate-700 transition-colors"
        >
          Features
        </a>
        <a
          href="/blog"
          class="font-bricolage tracking-wider block px-4 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-100 dark:text-gray-300 dark:hover:text-white dark:hover:bg-slate-700 transition-colors"
        >
          Blog
        </a>
        <hr class="my-2 border-gray-300 dark:border-gray-600">
        <a
          href="https://app.qare.in/sign_in"
          target="_blank"
          class="font-bricolage tracking-wider block px-4 py-2 text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-100 dark:text-gray-300 dark:hover:text-white dark:hover:bg-slate-700 transition-colors"
        >
          Login
        </a>
        <a
          href="https://app.qare.in/sign_up"
          target="_blank"
          class="block mx-4 my-2 px-4 py-2 rounded-md text-sm font-medium text-white bg-brand hover:bg-brand-dark focus:ring-2 focus:ring-brand-dark transition-colors text-center"
        >
          Get started
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  // Mobile menu toggle functionality
  const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (mobileMenuToggle && mobileMenu && hamburgerIcon && closeIcon) {
    let isOpen = false;

    mobileMenuToggle.addEventListener('click', () => {
      isOpen = !isOpen;
      
      if (isOpen) {
        // Open menu
        mobileMenu.style.maxHeight = mobileMenu.scrollHeight + 'px';
        mobileMenuToggle.setAttribute('aria-expanded', 'true');
        hamburgerIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
      } else {
        // Close menu
        mobileMenu.style.maxHeight = '0px';
        mobileMenuToggle.setAttribute('aria-expanded', 'false');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      }
    });

    // Close menu when clicking on a link (for single-page nabricolagetion)
    const mobileMenuLinks = mobileMenu.querySelectorAll('a[href^="#"]');
    mobileMenuLinks.forEach(link => {
      link.addEventListener('click', () => {
        isOpen = false;
        mobileMenu.style.maxHeight = '0px';
        mobileMenuToggle.setAttribute('aria-expanded', 'false');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      });
    });

    // Close menu when clicking outside
    document.addEventListener('click', (e) => {
      if (isOpen && !mobileMenuToggle.contains(e.target) && !mobileMenu.contains(e.target)) {
        isOpen = false;
        mobileMenu.style.maxHeight = '0px';
        mobileMenuToggle.setAttribute('aria-expanded', 'false');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      }
    });

    // Handle window resize
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024 && isOpen) { // lg breakpoint
        isOpen = false;
        mobileMenu.style.maxHeight = '0px';
        mobileMenuToggle.setAttribute('aria-expanded', 'false');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      }
    });
  }
</script>

