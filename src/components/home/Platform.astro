---
---
<!-- Problems Section -->
<section class="bg-gray-50" id="platform">
  <div class="max-w-6xl mx-auto px-6 lg:px-8 text-center">
    <div class="mb-3 inline-flex items-center gap-2 bg-brand/10 px-4 py-2 mx-auto rounded-md">
      <span class="text-sm font-semibold uppercase tracking-wide text-brand-dark"> Everyday tasks </span>
    </div>    
    <!-- Section Header -->
    <div class="text-center mb-16 px-10">
      <h2 class="mb-4 font-bricolage tracking-wider text-2xl font-bold text-slate-900 dark:text-white sm:text-3xl lg:text-4xl">
       A smooth and calm day at the clinic.
      </h2>
      <p class="mt-3 text-gray-600 text-xl">
       Qare keeps the basics simple, so your team can focus on patients.
      </p>
    </div>

    <!-- Features Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-3 gap-10">
      
      <div class="text-center p-16 bg-gray-100 transition flex flex-col items-center rounded-2xl">
        <div class="text-blue-600 text-5xl bg-blue-100 border-blue-400 mb-4 rounded-2xl border p-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/><path d="M16 18h.01"/>
          </svg>
        </div>
        <h3 class="font-bricolage tracking-wider text-xl font-semibold mb-2">Book appointments</h3>
        <p class="text-lg text-gray-600">
          Schedule visits and send reminders on WhatsApp.
        </p>
      </div>

      <div class="text-center p-16 bg-gray-100 transition flex flex-col items-center rounded-2xl">
        <div class="text-blue-600 text-5xl bg-blue-100 border-blue-400 mb-4 rounded-2xl border p-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6"  viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 6h4"/><path d="M2 10h4"/><path d="M2 14h4"/><path d="M2 18h4"/><rect width="16" height="20" x="4" y="2" rx="2"/><path d="M9.5 8h5"/><path d="M9.5 12H16"/><path d="M9.5 16H14"/></svg>          
        </div>             
        <h3 class="font-bricolage tracking-wider text-xl font-semibold mb-2">See patient history</h3>
        <p class="text-lg text-gray-600">
          Visits, notes, and bills in one clear timeline.
        </p>
      </div>

      <div class="text-center p-16 bg-gray-100 transition flex flex-col items-center rounded-2xl">
        <div class="text-blue-600 text-5xl bg-blue-100 border-blue-400 mb-4 rounded-2xl border p-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>          
        </div>
        <h3 class="font-bricolage tracking-wider text-xl font-semibold mb-2">Write care notes</h3>
        <p class="text-lg text-gray-600">
          Encounters, prescriptions, and consents together.
        </p>
      </div>

      <div class="text-center p-16 bg-gray-100 transition flex flex-col items-center rounded-2xl">
        <div class="text-blue-600 text-5xl bg-blue-100 border-blue-400 mb-4 rounded-2xl border p-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6"  viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 12h4"/><path d="M10 8h4"/><path d="M14 21v-3a2 2 0 0 0-4 0v3"/><path d="M6 10H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2"/><path d="M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16"/></svg>          
        </div>
        <h3 class="font-bricolage tracking-wider text-xl font-semibold mb-2">Send invoices</h3>
        <p class="text-lg text-gray-600">
          Create invoices and share payment links.
        </p>
      </div>

      <div class="text-center p-16 bg-gray-100 transition flex flex-col items-center rounded-2xl">
        <div class="text-blue-600 text-5xl bg-blue-100 border-blue-400 mb-4 rounded-2xl border p-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6"  viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 21V10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1v11"/><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 1.132-1.803l7.95-3.974a2 2 0 0 1 1.837 0l7.948 3.974A2 2 0 0 1 22 8z"/><path d="M6 13h12"/><path d="M6 17h12"/></svg>          
        </div>
        <h3 class="font-bricolage tracking-wider text-xl font-semibold mb-2">Track inventory</h3>
        <p class="text-lg text-gray-600">
          Know what is in stock across branches.
        </p>
      </div>
      
      <div class="text-center p-16 bg-gray-100 transition flex flex-col items-center rounded-2xl">
        <div class="text-blue-600 text-5xl bg-blue-100 border-blue-400 mb-4 rounded-2xl border p-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>          
        </div>
        <h3 class="font-bricolage tracking-wider text-xl font-semibold mb-2">Check reports</h3>
        <p class="text-lg text-gray-600">
          See performance without spreadsheets.
        </p>
      </div>

    </div>
  </div>
  <div class="max-w-6xl mx-auto px-6 lg:px-8 mt-10">
    <div class="bg-violet-200 rounded-2xl">
      <div class="mb-3 inline-flex items-center gap-2 bg-brand/10 px-4 py-2 mx-auto rounded-br-xl">
        <span class="text-sm font-semibold uppercase tracking-wide text-brand-dark"> Built for teams </span>
      </div>    
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-2">
        <div class="bg-[url(/images/doctors.png)] bg-no-repeat bg-left bg-cover w-full h-full">
         <span class="sr-only">doctors</span> 
        </div>
        <div class="px-10">
          <h2 class="mb-4 font-bricolage tracking-wider text-2xl font-bold dark:text-white sm:text-3xl lg:text-4xl">
          Everyone sees what they need.
          </h2>
          <p class="mt-3 text-xl">
            Give each role the right access, keep leadership visibility, and stay compliant.
          </p>
          <ul class="py-10 space-y-2 text-lg list-disc list-inside">
            <li>Roles for front desk, clinicians, and admins</li>
            <li>Multi-branch view for owners</li>
            <li>Reports across visits and revenue</li>
            <li>Activity history for sensitive changes</li>   
          </ul>
        </div>
      </div>
    </div>
  </div>    
</section>