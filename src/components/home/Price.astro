---
---
<section class="py-20 bg-gray-50" id="pricing">
  <div class="max-w-6xl mx-auto px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-10">
      <div class="mb-3 inline-flex items-center gap-2  bg-brand/10 px-4 py-2 mx-auto rounded-md">
        <span class="text-sm font-semibold uppercase tracking-wide text-brand-dark"> PRICING </span>
      </div>    

      <h2 class="mb-4 font-bricolage tracking-wider text-2xl font-bold text-slate-900 dark:text-white sm:text-3xl lg:text-4xl">
        Simple pricing that scales with you
      </h2>
      <p class="mt-4 text-lg text-gray-600">
        Choose the perfect plan for your clinic size
      </p>
    </div>

    <!-- Pricing Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Starter -->
      <div class="bg-white border shadow-sm p-8 flex flex-col rounded-xl">
        <div class="text-center">
          <h3 class="font-bricolage tracking-wider text-2xl font-semibold text-gray-900">
            Starter
          </h3>
          <p>Perfect for single-doctor clinics</p>
          <div class="font-bricolage tracking-wider mt-6 text-5xl font-bold text-brand">
            ₹999<span class="text-lg">/mo</span>
          </div>
        </div>
        <ul class="mt-6 space-y-3 text-gray-600 text-md">
          <li class="flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-600 mr-2" stroke-width="2" fill="none" stroke="currentColor"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-md">Up to 100 appointments/month</span>
          </li>
          <li class="flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-600 mr-2" stroke-width="2" fill="none" stroke="currentColor"><path d="M20 6 9 17l-5-5"/></svg>
            QR Code booking
          </li>
          <li class="flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-600 mr-2" stroke-width="2" fill="none" stroke="currentColor"><path d="M20 6 9 17l-5-5"/></svg>
            WhatsApp notifications
          </li>
          <li class="flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-600 mr-2" stroke-width="2" fill="none" stroke="currentColor"><path d="M20 6 9 17l-5-5"/></svg>
            Basic patient management
          </li>
          <li class="flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-600 mr-2" stroke-width="2" fill="none" stroke="currentColor"><path d="M20 6 9 17l-5-5"/></svg>
            Single doctor profile
          </li>  
          <li class="flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-600 mr-2" stroke-width="2" fill="none" stroke="currentColor"><path d="M20 6 9 17l-5-5"/></svg>
            Email support
          </li>                       
        </ul>

        <a
          href="https://app.qare.in/sign_in" target="_blank"
          class="mt-8 bg-brand text-white font-semibold py-3 px-6 hover:bg-brand-dark transition text-center rounded-md"
        >
          Sign Up for Free
        </a>
      </div>      
      <!-- Pro -->
      <div class="bg-white border shadow-sm p-8 flex flex-col rounded-xl">
        <div class="text-center">
          <h3 class="font-bricolage tracking-wider text-2xl font-semibold text-gray-900">
            Professional
          </h3>
          <p class="mb-6">
            For growing multi-doctor clinics
          </p>
          <div class="font-bricolage tracking-wider mt-6 text-5xl font-bold text-brand">
            ₹2,499<span class="text-lg">/mo</span>
          </div>
        </div>
        <ul class="mt-6 space-y-3 text-gray-600 text-md">
          <li class="flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-600 mr-2" stroke-width="2" fill="none" stroke="currentColor"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-md">Up to 500 appointments/month</span>
          </li>
          <li class="flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-600 mr-2" stroke-width="2" fill="none" stroke="currentColor"><path d="M20 6 9 17l-5-5"/></svg>
            Everything in Starter, plus:
          </li>
          <li class="flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-600 mr-2" stroke-width="2" fill="none" stroke="currentColor"><path d="M20 6 9 17l-5-5"/></svg>
            WhatsApp token system
          </li>
          <li class="flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-600 mr-2" stroke-width="2" fill="none" stroke="currentColor"><path d="M20 6 9 17l-5-5"/></svg>
            Up to 5 doctor profiles
          </li>   
          <li class="flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-600 mr-2" stroke-width="2" fill="none" stroke="currentColor"><path d="M20 6 9 17l-5-5"/></svg>
            Advanced analytics
          </li> 
          <li class="flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-600 mr-2" stroke-width="2" fill="none" stroke="currentColor"><path d="M20 6 9 17l-5-5"/></svg>
            Priority support
          </li>     
          <li class="flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-600 mr-2" stroke-width="2" fill="none" stroke="currentColor"><path d="M20 6 9 17l-5-5"/></svg>
            Custom branding
          </li>                  
        </ul>

        <a
          href="https://app.qare.in/sign_in" target="_blank"
          class="mt-8 bg-brand text-white font-semibold py-3 px-6 hover:bg-brand-dark transition text-center rounded-md"
        >
           Sign Up for Free
        </a>
      </div>

      <!-- Enterprise -->
      <div class="bg-brand text-white border-4 p-8 flex flex-col rounded-xl">
        <div class="text-center">
          <h3 class="font-bricolage tracking-wider text-2xl font-semibold text-white">
            Enterprise
          </h3>
          <p class="mb-6">
            For hospitals and large clinics
          </p>
          <div class="font-bricolage tracking-wider mt-6 text-5xl font-bold">Custom</div>
        </div>
        <ul class="mt-6 space-y-3 text-green-100 text-md">
          <li class="flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-500 mr-2" stroke-width="2" fill="none" stroke="currentColor"><path d="M20 6 9 17l-5-5"/></svg>
            Unlimited appointments
          </li>
          <li class="flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-500 mr-2" stroke-width="2" fill="none" stroke="currentColor"><path d="M20 6 9 17l-5-5"/></svg>
            Everything in Professional, plus:
          </li>
          <li class="flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-500 mr-2" stroke-width="2" fill="none" stroke="currentColor"><path d="M20 6 9 17l-5-5"/></svg>
            Unlimited doctors
          </li>
          <li class="flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-500 mr-2" stroke-width="2" fill="none" stroke="currentColor"><path d="M20 6 9 17l-5-5"/></svg>
            API access
          </li>  
          <li class="flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-500 mr-2" stroke-width="2" fill="none" stroke="currentColor"><path d="M20 6 9 17l-5-5"/></svg>
            Dedicated account manager
          </li>  
          <li class="flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-500 mr-2" stroke-width="2" fill="none" stroke="currentColor"><path d="M20 6 9 17l-5-5"/></svg>
            Custom integrations
          </li> 
          <li class="flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-500 mr-2" stroke-width="2" fill="none" stroke="currentColor"><path d="M20 6 9 17l-5-5"/></svg>
            SLA guarantee
          </li>                                       
        </ul>
        <a
          href="https://app.qare.in/sign_in" target="_blank"
          class="mt-8 bg-white text-violet-700 font-semibold py-3 px-6 hover:bg-gray-100 transition text-center rounded-md"
        >
          Contact Sales
        </a>
      </div>
    </div>
    <p class="text-xs text-gray-500 mt-10 text-center">
      *Prices shown are monthly rates billed annually. GST extra as applicable.
    </p>    
  </div>
</section>
