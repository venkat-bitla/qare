---
---

<section class="py-20">
  <div class="max-w-6xl mx-auto px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="mb-3 inline-flex items-center rounded-md gap-2 bg-brand/10 px-4 py-2 mx-auto">
        <span class="text-sm font-semibold uppercase tracking-wide text-brand-dark"> HOW IT WORKS </span>
      </div>        
      <h2 class="font-bricolage tracking-wider mb-4 text-3xl font-bold text-slate-900 dark:text-white sm:text-4xl lg:text-5xl">
        Get started in minutes
      </h2>
      <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto">
        Three simple steps to transform your scheduling process
      </p>
    </div>

    <!-- Steps -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
      
      <!-- Step 1 + WhatsApp Demo -->
      <div class="text-center p-8 bg-gray-100  rounded-2xl transition flex flex-col items-center">
         <div class="text-blue-600 text-5xl bg-blue-100 border-blue-400 mb-4 rounded-2xl border p-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 14v2.2l1.6 1"/><path d="M16 2v4"/><path d="M21 7.5V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h3.5"/><path d="M3 10h5"/><path d="M8 2v4"/><circle cx="16" cy="16" r="6"/></svg>                 
        </div>
        <h3 class="font-bricolage tracking-wider text-xl font-semibold mb-2">1. Set Your Schedule</h3>
        <p class="text-lg text-gray-600 mb-6">
          Add your working hours, consultation types, doctors, and time slots. Our intuitive interface makes it quick and easy.
        </p>
      </div>

      <!-- Step 2 -->
      <div class="text-center p-8 bg-gray-100  rounded-2xl transition flex flex-col items-center">
         <div class="text-blue-600 text-5xl bg-blue-100 border-blue-400 mb-4 rounded-2xl border p-2">
           <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="5" height="5" x="3" y="3" rx="1"/><rect width="5" height="5" x="16" y="3" rx="1"/><rect width="5" height="5" x="3" y="16" rx="1"/><path d="M21 16h-3a2 2 0 0 0-2 2v3"/><path d="M21 21v.01"/><path d="M12 7v3a2 2 0 0 1-2 2H7"/><path d="M3 12h.01"/><path d="M12 3h.01"/><path d="M12 16v.01"/><path d="M16 12h1"/><path d="M21 12v.01"/><path d="M12 21v-1"/></svg>          
        </div>
        <h3 class="font-bricolage tracking-wider text-xl font-semibold mb-2">2. Share Your QR Code</h3>
        <p class="text-lg text-gray-600">
          Print it for your reception, post it on social media, or add it to your website. Patients scan and book instantly.
        </p>
      </div>

      <!-- Step 3 -->
      <div class="text-center p-8 bg-gray-100  rounded-2xl transition flex flex-col items-center">
         <div class="text-blue-600 text-5xl bg-blue-100 border-blue-400 mb-4 rounded-2xl border p-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.268 21a2 2 0 0 0 3.464 0"/><path d="M22 8c0-2.3-.8-4.3-2-6"/><path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"/><path d="M4 2C2.8 3.7 2 5.7 2 8"/></svg>          
        </div>
        <h3 class="font-bricolage tracking-wider text-xl font-semibold mb-2">3. Relax & Focus</h3>
        <p class="text-lg text-gray-600">
          Automated reminders, confirmations, and token updates keep everything running smoothly while you focus on patients.
        </p>
      </div>

    </div>
  </div>
</section>
