---
---

<section class="py-20" id="modules">
  <div class="max-w-6xl mx-auto px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="mb-3 inline-flex items-center rounded-md gap-2 bg-brand/10 px-4 py-2 mx-auto">
        <span class="text-sm font-semibold uppercase tracking-wide text-brand-dark"> What you get </span>
      </div>        
      <h2 class="font-bricolage tracking-wider mb-4 text-3xl font-bold text-slate-900 dark:text-white sm:text-4xl lg:text-5xl">
        All the essentials, already connected.
      </h2>
      <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto">
        Each module is built to work together, so nothing gets missed.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
    
      <div class="p-8 bg-gray-100 rounded-2xl transition flex flex-col">
        <div class="flex gap-2">
          <div class="text-5xl py-2  text-violet-600">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 14v2.2l1.6 1"/><path d="M16 2v4"/><path d="M21 7.5V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h3.5"/><path d="M3 10h5"/><path d="M8 2v4"/><circle cx="16" cy="16" r="6"/></svg>                 
          </div>
          <h3 class="font-bricolage tracking-wider text-xl font-semibold mt-2">Appointments</h3>
        </div>

        <p class="text-lg text-gray-600">
          Book, reschedule, and confirm visits in seconds.
        </p>
        <ul class="w-full list-disc pl-5">
          <li class="text-gray-600 text-left mt-2">Day, week, month views</li>
          <li class="text-gray-600 text-left mt-2">WhatsApp reminders</li>
          <li class="text-gray-600 text-left mt-2">Quick reschedule</li>
        </ul>         
      </div>

      <div class="p-8 bg-gray-100 rounded-2xl transition flex flex-col">
        <div class="flex gap-2">
          <div class="text-5xl py-2  text-violet-600">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users-round-icon lucide-users-round"><path d="M18 21a8 8 0 0 0-16 0"/><circle cx="10" cy="8" r="5"/><path d="M22 20c0-3.37-2-6.5-4-8a5 5 0 0 0-.45-8.3"/></svg>            
          </div>
          <h3 class="font-bricolage tracking-wider text-xl font-semibold mt-2">Patients</h3>
        </div>

        <p class="text-lg text-gray-600">
          Clean profiles with all the essentials in one place.
        </p>
        <ul class="w-full list-disc pl-5">
          <li class="text-gray-600 text-left mt-2">Contact details</li>
          <li class="text-gray-600 text-left mt-2">Visit history</li>
          <li class="text-gray-600 text-left mt-2">Packages and memberships</li>
        </ul>         
      </div>

      <div class="p-8 bg-gray-100 rounded-2xl transition flex flex-col">
        <div class="flex gap-2">
          <div class="text-5xl py-2  text-violet-600">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-notebook-text-icon lucide-notebook-text"><path d="M2 6h4"/><path d="M2 10h4"/><path d="M2 14h4"/><path d="M2 18h4"/><rect width="16" height="20" x="4" y="2" rx="2"/><path d="M9.5 8h5"/><path d="M9.5 12H16"/><path d="M9.5 16H14"/></svg>            
          </div>
          <h3 class="font-bricolage tracking-wider text-xl font-semibold mt-2">Care notes</h3>
        </div>        
        <p class="text-lg text-gray-600">
          Encounters, prescriptions, and files in one flow.
        </p>
        <ul class="w-full list-disc pl-5">
          <li class="text-gray-600 text-left mt-2">Specialty templates</li>
          <li class="text-gray-600 text-left mt-2">Photos and uploads</li>
          <li class="text-gray-600 text-left mt-2">Consent capture</li>
        </ul>         
      </div>

      <div class="p-8 bg-gray-100 rounded-2xl transition flex flex-col">
        <div class="flex gap-2">
          <div class="text-5xl py-2  text-violet-600">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-receipt-indian-rupee-icon lucide-receipt-indian-rupee"><path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/><path d="M8 7h8"/><path d="M12 17.5 8 15h1a4 4 0 0 0 0-8"/><path d="M8 11h8"/></svg>            
          </div>
          <h3 class="font-bricolage tracking-wider text-xl font-semibold mt-2">Billing</h3>
        </div>        
        <p class="text-lg text-gray-600">
          Invoices and payment links without the paperwork.
        </p>
        <ul class="w-full list-disc pl-5">
          <li class="text-gray-600 text-left mt-2">GST-ready invoices</li>
          <li class="text-gray-600 text-left mt-2">Packages and memberships</li>
          <li class="text-gray-600 text-left mt-2">Razorpay payments</li>
        </ul>        
      </div>

      <div class="p-8 bg-gray-100 rounded-2xl transition flex flex-col">
        <div class="flex gap-2">
          <div class="text-5xl py-2  text-violet-600">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-pile-icon lucide-circle-pile"><circle cx="12" cy="19" r="2"/><circle cx="12" cy="5" r="2"/><circle cx="16" cy="12" r="2"/><circle cx="20" cy="19" r="2"/><circle cx="4" cy="19" r="2"/><circle cx="8" cy="12" r="2"/></svg>            
          </div>
          <h3 class="font-bricolage tracking-wider text-xl font-semibold mt-2">Inventory</h3>
        </div>        

        <p class="text-lg text-gray-600">
          Know what is in stock before you run out.
        </p>
        <ul class="w-full list-disc pl-5">
          <li class="text-gray-600 text-left mt-2">Stock tracking</li>
          <li class="text-gray-600 text-left mt-2">Branch visibility</li>
          <li class="text-gray-600 text-left mt-2">Audit logs</li>
        </ul>
      </div>
      
      <div class="p-8 bg-gray-100 rounded-2xl transition flex flex-col">
        <div class="flex gap-2">
          <div class="text-5xl py-2  text-violet-600">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users-icon lucide-users"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><path d="M16 3.128a4 4 0 0 1 0 7.744"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><circle cx="9" cy="7" r="4"/></svg>            
          </div>
          <h3 class="font-bricolage tracking-wider text-xl font-semibold mt-2">Team access</h3>
        </div>        

        <p class="text-lg text-gray-600">
          Give everyone the right access and stay in control.
        </p>
        <ul class="w-full list-disc pl-5">
          <li class="text-gray-600 text-left mt-2">Roles and permissions</li>
          <li class="text-gray-600 text-left mt-2">Activity history</li>
          <li class="text-gray-600 text-left mt-2">Reports</li>
        </ul>
      </div>

    </div>
  </div>
</section>
