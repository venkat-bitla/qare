---
---
<!-- Problems Section -->
<section class="bg-gray-50" id="features">
  <div class="max-w-6xl mx-auto px-6 lg:px-8 text-center">
    <div class="mb-3 inline-flex items-center gap-2 bg-brand/10 px-4 py-2 mx-auto rounded-md">
      <span class="text-sm font-semibold uppercase tracking-wide text-brand-dark"> FEATURES </span>
    </div>    
    <!-- Section Header -->
    <div class="text-center mb-16 px-10">
      <h2 class="mb-4 font-bricolage tracking-wider text-2xl font-bold text-slate-900 dark:text-white sm:text-3xl lg:text-4xl">
       Everything you need, nothing you don't
      </h2>
      <p class="mt-3 text-gray-600 text-xl">
        Powerful features designed specifically for busy clinics and their patients
      </p>
    </div>

    <!-- Features Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-3 gap-10">
      
      <div class="text-center p-16 bg-gray-100 transition flex flex-col items-center rounded-2xl">
        <div class="text-blue-600 text-5xl bg-blue-100 border-blue-400 mb-4 rounded-2xl border p-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6"  viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="5" height="5" x="3" y="3" rx="1"/><rect width="5" height="5" x="16" y="3" rx="1"/><rect width="5" height="5" x="3" y="16" rx="1"/><path d="M21 16h-3a2 2 0 0 0-2 2v3"/><path d="M21 21v.01"/><path d="M12 7v3a2 2 0 0 1-2 2H7"/><path d="M3 12h.01"/><path d="M12 3h.01"/><path d="M12 16v.01"/><path d="M16 12h1"/><path d="M21 12v.01"/><path d="M12 21v-1"/></svg>
        </div>
        <h3 class="font-bricolage tracking-wider text-xl font-semibold mb-2">QR Code Booking</h3>
        <p class="text-lg text-gray-600">
          Patients scan, pick a time, and book instantly. No apps, no hassle, no waiting on hold.
        </p>
      </div>

      <div class="text-center p-16 bg-gray-100 transition flex flex-col items-center rounded-2xl">
        <div class="text-blue-600 text-5xl bg-blue-100 border-blue-400 mb-4 rounded-2xl border p-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6"  viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719"/><path d="M8 12h.01"/><path d="M12 12h.01"/><path d="M16 12h.01"/></svg>
        </div>             
        <h3 class="font-bricolage tracking-wider text-xl font-semibold mb-2">WhatsApp Integration</h3>
        <p class="text-lg text-gray-600">
          Automatic reminders, confirmations, and updates via WhatsApp reduce no-shows by up to 80%.
        </p>
      </div>

      <div class="text-center p-16 bg-gray-100 transition flex flex-col items-center rounded-2xl">
        <div class="text-blue-600 text-5xl bg-blue-100 border-blue-400 mb-4 rounded-2xl border p-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.268 21a2 2 0 0 0 3.464 0"/><path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"/></svg>          
        </div>
        <h3 class="font-bricolage tracking-wider text-xl font-semibold mb-2">Smart Notifications</h3>
        <p class="text-lg text-gray-600">
          Real-time updates for bookings, reschedules, cancellations, and queue position.
        </p>
      </div>

      <div class="text-center p-16 bg-gray-100 transition flex flex-col items-center rounded-2xl">
        <div class="text-blue-600 text-5xl bg-blue-100 border-blue-400 mb-4 rounded-2xl border p-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16.247 7.761a6 6 0 0 1 0 8.478"/><path d="M19.075 4.933a10 10 0 0 1 0 14.134"/><path d="M4.925 19.067a10 10 0 0 1 0-14.134"/><path d="M7.753 16.239a6 6 0 0 1 0-8.478"/><circle cx="12" cy="12" r="2"/></svg>
        </div>
        <h3 class="font-bricolage tracking-wider text-xl font-semibold mb-2">Live Availability</h3>
        <p class="text-lg text-gray-600">
          Your calendar updates in real-time. Patients only see slots that are actually open.
        </p>
      </div>

      <div class="text-center p-16 bg-gray-100 transition flex flex-col items-center rounded-2xl">
        <div class="text-blue-600 text-5xl bg-blue-100 border-blue-400 mb-4 rounded-2xl border p-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8" r="5"/>
            <path d="M20 21a8 8 0 0 0-16 0"/>
          </svg>
        </div>
        <h3 class="font-bricolage tracking-wider text-xl font-semibold mb-2">Patient Management</h3>
        <p class="text-lg text-gray-600">
          Store patient details, track visit history, and manage recurring appointments effortlessly.
        </p>
      </div>
      
      <div class="text-center p-16 bg-gray-100 transition flex flex-col items-center rounded-2xl">
        <div class="text-blue-600 text-5xl bg-blue-100 border-blue-400 mb-4 rounded-2xl border p-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/><path d="M16 18h.01"/>
          </svg>
        </div>
        <h3 class="font-bricolage tracking-wider text-xl font-semibold mb-2">Flexible Scheduling</h3>
        <p class="text-lg text-gray-600">
          Set custom availability, block time off, and manage multiple doctors seamlessly.
        </p>
      </div>
      
      <div class="text-center p-16 bg-gray-100 transition flex flex-col items-center rounded-2xl">
        <div class="text-blue-600 text-5xl bg-blue-100 border-blue-400 mb-4 rounded-2xl border p-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13.5 8h-3"/><path d="m15 2-1 2h3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h3"/><path d="M16.899 22A5 5 0 0 0 7.1 22"/><path d="m9 2 3 6"/><circle cx="12" cy="15" r="3"/></svg>          
        </div>
        <h3 class="font-bricolage tracking-wider text-xl font-semibold mb-2">Digital Doctor Profile</h3>
        <p class="text-lg text-gray-600">
          Professional profiles with credentials, specialties, and patient reviews - build trust before they book.
        </p>
      </div>
      
      <div class="text-center p-16 bg-gray-100 transition flex flex-col items-center rounded-2xl">
        <div class="text-blue-600 text-5xl bg-blue-100 border-blue-400 mb-4 rounded-2xl border p-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><rect x="9" y="9" width="6" height="6" rx="1"/></svg>          
        </div>
        <h3 class="font-bricolage tracking-wider text-xl font-semibold mb-2">WhatsApp Token System</h3>
        <p class="text-lg text-gray-600">
          Smart token flow that works with your existing OPD workflow - no disruption, just efficiency.
        </p>
      </div>
      
      <div class="text-center p-16 bg-gray-100 transition flex flex-col items-center rounded-2xl">
        <div class="text-blue-600 text-5xl bg-blue-100 border-blue-400 mb-4 rounded-2xl border p-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chart-no-axes-combined-icon lucide-chart-no-axes-combined"><path d="M12 16v5"/><path d="M16 14v7"/><path d="M20 10v11"/><path d="m22 3-8.646 8.646a.5.5 0 0 1-.708 0L9.354 8.354a.5.5 0 0 0-.707 0L2 15"/><path d="M4 18v3"/><path d="M8 14v7"/></svg>          
        </div>
        <h3 class="font-bricolage tracking-wider text-xl font-semibold mb-2">Analytics and Reporting</h3>
        <p class="text-lg text-gray-600">
          Gain insights with powerful analytics and reporting tools
        </p>
      </div>

    </div>
  </div>
</section>