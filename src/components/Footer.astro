<footer class="py-10 border-t w-full text-gray-800 bg-gray-50">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:justify-between gap-10 md:gap-16">
      
      <!-- Footer Left (Logo + Social) -->
      <div class="flex-1 text-center md:text-left">
        <div class="max-w-[250px] space-y-4">
          <a href="/" class="flex mx-2 md:justify-start">
            <svg xmlns="http://www.w3.org/2000/svg"  class="w-8 h-8 text-brand mt-2"  viewBox="0 0 24 24">
              <path fill="currentColor" d="M20.143 18.857h-1.655l-1.898-1.761a6.857 6.857 0 1 1 1.543-2.032l-1.02-.844a5.572 5.572 0 1 0-1.47 1.997l-.948-.883a4.286 4.286 0 1 1 .866-.947zM12 15a3 3 0 1 0 0-6a3 3 0 0 0 0 6"/>
