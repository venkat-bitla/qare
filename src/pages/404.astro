---
import Layout from '../layouts/Layout.astro';
---

<Layout title="qare - Simplify Your Clinic Management">
  <div class="container mx-auto px-4 py-8 max-w-5xl my-20">
    <h1 class="text-4xl font-bold text-center mb-4">404 - Page Not Found</h1>
    <div class="max-w-3xl flex-1 [&>h2]:text-xl [&>h2]:font-bold [&>p]:mb-6 mx-auto p-10 text-center">
      <p>Sorry, the page you are looking for does not exist.</p>
      <p>Please check the URL or return to the <a href="/" class="text-brand underline">homepage</a>.</p>
    </div>
  </div>    
</Layout>