---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const posts = await getCollection("blog");

const sortedPosts = posts.sort((a, b) => {
  return +new Date(b.data.createdDate) - +new Date(a.data.createdDate);
});
---

<Layout title="qare - Simplify Your Clinic Management">
  <section class="mt-20 rounded-t-3xl">
    <div class="max-w-5xl mx-auto py-10 px-4 sm:px-6 md:px-10">
      <h1 class="text-xl md:text-2xl font-semibold font-bricolage">
        Blog Posts
      </h1>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-10 py-8">
        {sortedPosts.map((p) => (
          <div class="border p-6 md:p-10 rounded-md bg-gray-50 shadow-sm w-full">
            <a
              class="text-base md:text-lg font-medium hover:underline block mb-2"
              href={`/blog/${p.slug}`}
            >
              {p.data.title}
            </a>

            <div class="text-sm md:text-md text-gray-600">
              {p.data.summary}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
