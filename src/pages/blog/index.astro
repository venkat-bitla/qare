---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
const posts = await getCollection("blog");

const sortedPosts = posts.sort((a, b) => {
  return +new Date(b.data.createdDate) - +new Date(a.data.createdDate);
});
---
<Layout title="Automated scheduling, confirmations & WhatsApp reminders — so you don’t have to follow up. 📲✨">
  <section class="mt-20 rounded-t-3xl  h-vh">
    <div class="max-w-5xl mx-auto py-10 px-10">
      <h1 class="text-2xl font-semibold">Blog Posts</h1>
      <div class="flex gap-10 py-10">
        {
          sortedPosts.map((p) => {
            return (
              <div class="border p-10 rounded-md bg-gray-50 shadow-sm w-1/2">
                <a class="text-xl underline" href={"/blog/" + p.slug}>{p.data.title}</a>
                <div class="text-md">{p.data.summary}</div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>
</Layout>